# 复制成 .env.local 填入真实值。全部留空则以 Demo 模式运行（假数据、不调 AI）

# 你的个人 Claude API key（console.anthropic.com）。留空=Demo，不真正调用 AI
ANTHROPIC_API_KEY=

# 走第三方网关时填它的地址；留空=官方 api.anthropic.com
ANTHROPIC_BASE_URL=

# 换模型用，留空=claude-opus-5。可选值和实测准确率见 lib/claude.ts 顶部注释。
# 想省钱可试 deepseek-v4-flash-nothinking（同样 5/5 但慢些）
AI_MODEL=

# Supabase 项目设置里拿。留空=用内存假数据
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 访问口令。设了之后，App 首次记录会要求输入；留空=不设防（仅本地开发用）
APP_PASSPHRASE=
